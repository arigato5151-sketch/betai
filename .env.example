# Root-level environment variables
# Use either this file or backend/.env
ENVIRONMENT=development
DEBUG=true
SECRET_PROVIDER=env
# VAULT_ADDR=https://vault.example.com
# VAULT_MOUNT_POINT=secret
# VAULT_SECRET_PATH=bet-ai/production
# VAULT_ROLE_ID=replace_with_approle_role_id
# VAULT_SECRET_ID=inject_at_runtime_do_not_commit
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net
# AZURE_KEY_VAULT_PREFIX=bet-ai
API_FOOTBALL_KEY=your_api_football_key
FOOTBALL_DATA_BASE_URL=https://www.football-data.co.uk
FOOTBALL_DATA_TIMEOUT_SECONDS=20
RECENT_FORM_MATCH_COUNT=5
HISTORICAL_FORM_MAX_AGE_DAYS=45
ELO_K_FACTOR=32
ELO_HOME_ADVANTAGE_POINTS=65
ELO_SEASON_REGRESSION=0.25
MIN_ENSEMBLE_CALIBRATION_SAMPLES=100
ENSEMBLE_HOLDOUT_FRACTION=0.2
ENSEMBLE_MIN_SOURCE_WEIGHT=0.05
ENSEMBLE_MIN_LOG_LOSS_IMPROVEMENT=0.001
DATABASE_URL=postgresql://betai:betai@postgres:5432/bet_ai
ALLOW_DATABASE_FALLBACK=true
REDIS_URL=redis://redis:6379/0
MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211
MEMCACHED_TIMEOUT_SECONDS=2
JWT_SECRET_KEY=your_jwt_secret_key
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_secret_key
MODEL_SIGNING_KEY=replace_with_a_distinct_32_character_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_TOKEN_COOKIE_NAME=bet_ai_access
REFRESH_TOKEN_COOKIE_NAME=bet_ai_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REQUIRE_ORIGIN_HEADER=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
LOGIN_REDIS_RECOVERY_SECONDS=30
CSRF_COOKIE_NAME=bet_ai_csrf
CSRF_HEADER_NAME=X-CSRF-Token
# COOKIE_DOMAIN=example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_EMAIL=admin@example.com
ALLOW_SELF_REGISTRATION=false
SELF_REGISTRATION_ROLE=viewer
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
VITE_API_BASE_URL=http://localhost:8000/api
VITE_CSRF_COOKIE_NAME=bet_ai_csrf
VITE_CSRF_HEADER_NAME=X-CSRF-Token

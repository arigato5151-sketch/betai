    "/api/history": {
      "get": {
        "summary": "Get History",
        "operationId": "get_history_api_history_get",
        "security": [
          {
            "CookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "paginated",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Paginated"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 15,
              "title": "Page Size"
            }
          },
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "default": "",
              "title": "Query"
            }
          },
          {
            "name": "result",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "all",
                "pending",
                "HOME_WIN",
                "DRAW",
                "AWAY_WIN"
              ],
              "type": "string",
              "default": "all",
              "title": "Result"
            }
          },
          {
            "name": "value",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "all",
                "value",
                "non_value"
              ],
              "type": "string",
              "default": "all",
              "title": "Value"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "newest",
                "oldest",
                "edge",
                "odd"
              ],
              "type": "string",
              "default": "newest",
              "title": "Sort"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },

  "components": {
    "schemas": {
      "ActualResultUpdate": {
        "properties": {
          "actual_result": {
            "type": "string",
            "pattern": "^(HOME_WIN|DRAW|AWAY_WIN)$",
            "title": "Actual Result",
            "description": "Match result"
          },
          "actual_score_home": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 50.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual Score Home",
            "description": "Home team goals"
          },
          "actual_score_away": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 50.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual Score Away",
            "description": "Away team goals"
          }
        },
        "type": "object",
        "required": [
          "actual_result"
        ],
        "title": "ActualResultUpdate"
      },
      "AdminRoleResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Permissions"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "permissions"
        ],
        "title": "AdminRoleResponse"
      },
      "AdminUserCreate": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "title": "Username"
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "title": "Password"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Roles"
          }
        },
        "type": "object",
        "required": [
          "username",
          "email",
          "password",
          "roles"
        ],
        "title": "AdminUserCreate"
      },
      "AdminUserResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Roles"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Permissions"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "email",
          "is_active",
          "roles",
          "permissions",
          "created_at"
        ],

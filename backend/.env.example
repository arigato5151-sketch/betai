# API-Football anahtariniz (https://www.api-football.com/)
ENVIRONMENT=development
DEBUG=true
SECRET_PROVIDER=env
# VAULT_ADDR=https://vault.example.com
# VAULT_MOUNT_POINT=secret
# VAULT_SECRET_PATH=bet-ai/production
# VAULT_ROLE_ID=replace_with_approle_role_id
# VAULT_SECRET_ID=inject_at_runtime_do_not_commit
API_FOOTBALL_KEY=your_api_key_here
FOOTBALL_DATA_BASE_URL=https://www.football-data.co.uk
FOOTBALL_DATA_TIMEOUT_SECONDS=20
FIXTURE_DOWNLOAD_BASE_URL=https://fixturedownload.com/feed/json
FIXTURE_DOWNLOAD_TIMEOUT_SECONDS=20
CLUBELO_ENABLED=true
CLUBELO_BASE_URL=http://api.clubelo.com
CLUBELO_TIMEOUT_SECONDS=15
CLUBELO_CACHE_HOURS=24
CLUBELO_CONFIDENCE=0.80
ODDS_SNAPSHOT_MIN_INTERVAL_SECONDS=300
ODDS_SNAPSHOT_CONFIDENCE=0.90
ODDS_COLLECTOR_ENABLED=true
ODDS_COLLECTOR_RUN_INTERVAL_SECONDS=10800
ODDS_COLLECTOR_HORIZON_DAYS=7
ODDS_COLLECTOR_MAX_FIXTURES=20
ODDS_COLLECTOR_CLOSING_WINDOW_HOURS=24
ODDS_COLLECTOR_CONCURRENCY=2
LINEUP_COLLECTOR_ENABLED=true
LINEUP_COLLECTOR_RUN_INTERVAL_SECONDS=3600
LINEUP_COLLECTOR_HORIZON_DAYS=2
LINEUP_COLLECTOR_MAX_FIXTURES=30
LINEUP_COLLECTOR_WINDOW_MINUTES=120
LINEUP_COLLECTOR_CONCURRENCY=2
SPORTMONKS_ENABLED=false
SPORTMONKS_API_TOKEN=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_TIMEOUT_SECONDS=15
SPORTMONKS_PLAYER_LOOKBACK_DAYS=120
SPORTMONKS_PLAYER_LOOKBACK_MATCHES=10
API_FOOTBALL_CIRCUIT_FAILURE_THRESHOLD=4
API_FOOTBALL_CIRCUIT_OPEN_SECONDS=60
API_FOOTBALL_MAX_RETRY_AFTER_SECONDS=120
API_FOOTBALL_BACKOFF_JITTER_RATIO=0.2
AUTO_TEAM_LOCATION_ENABLED=true
GOAL_TIME_DECAY_FACTOR=0.008
RECENT_FORM_MATCH_COUNT=5
HISTORICAL_FORM_MAX_AGE_DAYS=45
PLAYER_IMPACT_MIN_RATED_STARTERS=7
PLAYER_IMPACT_LOOKBACK_MATCHES=10
PLAYER_IMPACT_RATING_DECAY=0.85
PLAYER_IMPACT_REPLACEMENT_FACTOR=0.75
PLAYER_IMPACT_MIN_STRENGTH_RATIO=0.70
PLAYER_IMPACT_MAX_STRENGTH_RATIO=1.05
PLAYER_IMPACT_XG_ELASTICITY=1.0
PLAYER_IMPACT_MIN_XG_MULTIPLIER=0.75
PLAYER_CRITICAL_ABSENCE_WEIGHT=0.25
PLAYER_QUESTIONABLE_ABSENCE_WEIGHT=0.35
PLAYER_CONTEXT_SYNC_MAX_FIXTURES=20
PLAYER_CONTEXT_SYNC_CONCURRENCY=3
FATIGUE_LOOKBACK_DAYS=14
FATIGUE_MATCH_REFERENCE_COUNT=4
FATIGUE_IDEAL_REST_DAYS=7
FATIGUE_TRAVEL_REFERENCE_KM=3000
FATIGUE_MATCH_WEIGHT=0.45
FATIGUE_REST_WEIGHT=0.40
FATIGUE_TRAVEL_WEIGHT=0.15
ELO_K_FACTOR=32
ELO_HOME_ADVANTAGE_POINTS=65
ELO_SEASON_REGRESSION=0.25
MIN_ENSEMBLE_CALIBRATION_SAMPLES=100
ENSEMBLE_HOLDOUT_FRACTION=0.2
ENSEMBLE_MIN_SOURCE_WEIGHT=0.05
ENSEMBLE_MIN_LOG_LOSS_IMPROVEMENT=0.001
ENSEMBLE_BMA_MIN_LEAGUE_SAMPLES=30
ENSEMBLE_BMA_PRIOR_STRENGTH=50
ENSEMBLE_BMA_HALF_LIFE_DAYS=180
ENSEMBLE_BMA_MIN_DATA_QUALITY_SCORE=0
ENSEMBLE_BMA_MAX_BRIER_REGRESSION=0.005
ENSEMBLE_BMA_STATS_LOW_DATA_BOOST=1.5
ENSEMBLE_BMA_ML_HIGH_QUALITY_BOOST=1.5
ENABLE_CATBOOST_CANDIDATE=true
ENABLE_LIGHTGBM_CANDIDATE=true
ML_BOOSTER_TREES=200
ML_BOOSTER_MAX_DEPTH=6
ML_BOOSTER_LEARNING_RATE=0.05
ML_BOOSTER_THREADS=2
MODEL_DRIFT_WINDOW_SIZE=100
MODEL_DRIFT_MIN_SAMPLES=30
MODEL_DRIFT_BRIER_THRESHOLD=0.04

# Postgres database connection
DATABASE_URL=postgresql://betai:betai@postgres:5432/bet_ai
ALLOW_DATABASE_FALLBACK=true

# Redis cache and Celery broker
REDIS_URL=redis://redis:6379/0
MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211
MEMCACHED_TIMEOUT_SECONDS=2

# JWT secrets for authentication
JWT_SECRET_KEY=your_jwt_secret_key
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_secret_key
MODEL_SIGNING_KEY=replace_with_a_distinct_32_character_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_TOKEN_COOKIE_NAME=bet_ai_access
REFRESH_TOKEN_COOKIE_NAME=bet_ai_refresh
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
LOGIN_REDIS_RECOVERY_SECONDS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REQUIRE_ORIGIN_HEADER=false
# COOKIE_DOMAIN=example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_EMAIL=admin@example.com

# Frontend and CORS configuration
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO
